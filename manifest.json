{
  "manifest_version": 3,
  "name": "HTML Viewer",
  "version": "1.0.0",
  "description": "Zobrazuje aktuální (vykreslený) HTML kód otevřené stránky v postranním panelu.",
  "permissions": ["scripting", "sidePanel", "tabs", "downloads"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Zobrazit HTML kód stránky",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
